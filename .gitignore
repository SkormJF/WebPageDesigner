# Transient Builder project work — the only non-tracked path in this repo.
# A Builder project lives here while it is being discovered, planned and reviewed,
# and is deleted by reset-builder after handoff. Generated projects live outside
# this repository entirely (see builder.config.json -> projects_root).
.builder/current/

# Staging area used by create-project before a repo is moved to its final target
.staging/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.production
.env.development

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings (per-machine tool-permission allowlist the harness
# keeps -- not project code, nothing to share via git)
.claude/settings.local.json
.claude/settings.json

# Vercel
.vercel/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (skill scripts, e.g. ui-ux-pro-max)
__pycache__/
*.pyc

# Playwright / screenshots
playwright-cli-screenshots/
*.png

# Script scratch output
*.log
